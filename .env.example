# Hackwave Police AI - Environment Variables Template
# Copy this file to .env and configure your local keys

# Featherless.ai LLM Integration (Hackathon Requirement)
# Obtain your key from https://featherless.ai
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Core System
SECRET_KEY=hackwave-police-secret-key-2026-production-ready
DEBUG=False
OPERATION_MODE=BALANCED
